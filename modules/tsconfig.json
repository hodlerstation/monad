{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": [
    "*.ts",
    "*.tsx",
    "test/*.ts",
    "demo/*.ts",
    "demo/*.tsx"
  ]
}
